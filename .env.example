# No configuration is required for local development (embedded PostgreSQL in .data/).
# On Render, connect a PostgreSQL database and set its internal connection URL:
# DATABASE_URL=postgresql://user:password@host:5432/marginly
# Never prefix database credentials with NEXT_PUBLIC_.
# Render supplies RENDER_EXTERNAL_URL automatically. For a custom domain:
# APP_ORIGIN=https://your-domain.example
